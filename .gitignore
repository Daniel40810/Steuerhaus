# Build- und Ausgabeordner (Ant/NetBeans)
/build/
/dist/
*.class

# Lokale NetBeans-Einstellungen
/nbproject/private/

# Bibliotheken nicht im Repo (F258 B), siehe README, Abschnitt Bibliotheken.
# Nur die NetBeans-Bibliotheksdefinition bleibt, damit das Projekt sauber oeffnet.
/lib/*
!/lib/nblibraries.properties
!/lib/CopyLibs/

# Arbeitsstaende, Absturzprotokolle
/_to_delete/
hs_err_pid*.log

# Python-Zwischenstaende
__pycache__/
*.pyc

# Backups und temporaere Dateien
*.bak
*~
Thumbs.db
.DS_Store
